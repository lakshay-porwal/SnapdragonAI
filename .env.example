# VibeGuard NeuroEdge Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# AI Inference Backend ('auto', 'qnn', 'cpu', 'dml')
# 'auto' prioritizes Qualcomm QNN on Snapdragon ARM64, gracefully falling back to CPU on Intel x64
AI_BACKEND=auto
MODEL_FP32_PATH=models/vibenet_1d_fp32.onnx
MODEL_INT8_PATH=models/vibenet_1d_int8.onnx
PREFER_INT8=True

# Hardware Mode ('simulation' or 'hardware')
HARDWARE_MODE=simulation
ARDUINO_PORT=COM3
ARDUINO_BAUD=115200

# Telemetry & Sampling
SAMPLING_RATE_HZ=1000
WINDOW_SIZE=512
INFERENCE_INTERVAL_SEC=0.1
ALERT_RMS_THRESHOLD=4.5
TRIP_RMS_THRESHOLD=7.1
